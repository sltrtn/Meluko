rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPERS =====
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isTribeMember(tribeId) {
      return isAuthenticated() && exists(
        /databases/$(database)/documents/tribes/$(tribeId)/members/$(request.auth.uid)
      );
    }

    function isTribeAdmin(tribeId) {
      return isAuthenticated() && get(
        /databases/$(database)/documents/tribes/$(tribeId)/members/$(request.auth.uid)
      ).data.role == 'admin';
    }

    function isValidProposalStatusTransition(oldStatus, newStatus) {
      return oldStatus == 'pending' && (newStatus == 'vetoed' || newStatus == 'accepted');
    }

    // ===== USER PROFILES =====
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ===== USER ALARMS =====
    match /user_alarms/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ===== TRIBES =====
    match /tribes/{tribeId} {
      // Any authenticated user can read public tribe data (needed for invite-code lookup).
      // Creation is allowed by any authenticated user.
      // Updates restricted to tribe members.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isTribeMember(tribeId);
      // Only the admin can delete a tribe, and only once they're the last member
      // (prevents orphaning other members' data).
      allow delete: if isTribeAdmin(tribeId) && resource.data.memberCount <= 1;

      // ===== TRIBE MEMBERS =====
      // Any tribe member can read the member list.
      // Each user creates/updates only their own member document.
      // A member can delete their own membership (leave); an admin can remove others.
      match /members/{memberUid} {
        allow read: if isTribeMember(tribeId);
        allow create: if isOwner(memberUid)
          && !exists(/databases/$(database)/documents/tribes/$(tribeId)/members/$(memberUid));
        allow update: if isOwner(memberUid);
        allow delete: if isOwner(memberUid) || isTribeAdmin(tribeId);
      }

      // ===== PROPOSALS =====
      // Members can read/create/update proposals.
      // Status transitions are restricted: pending -> vetoed | accepted only.
      // The proposer must match the authenticated user.
      // Deletion is not allowed (audit trail).
      match /proposals/{proposalId} {
        allow read: if isTribeMember(tribeId);
        allow create: if isTribeMember(tribeId)
          && request.resource.data.proposedBy == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if isTribeMember(tribeId)
          && isValidProposalStatusTransition(resource.data.status, request.resource.data.status)
          && request.resource.data.proposedBy == resource.data.proposedBy
          && request.resource.data.proposedTime == resource.data.proposedTime;
        allow delete: if false;
      }
    }
  }
}
