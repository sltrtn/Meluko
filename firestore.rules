rules_version = '2';

// Meluko security rules.
//
// Design (no server required):
//   • Invite codes live at invites/{CODE} → { tribeId }. They can be fetched only
//     by someone who already knows the code (no listing), and the code being the
//     document ID makes it unique.
//   • A tribe has at most one live proposal: tribes/{id}.activeProposalId.
//     The tribe's alarmTime can only change in the same write that accepts that
//     proposal, and only after createdAt (server time) + 2h. A solo tribe's admin
//     can set the time directly — there is no one to veto.
//   • memberCount must move in lockstep with real member create/delete.
//   • Members can only write their own status/stat fields, within limits:
//     role is locked, streak only +1 (with a new recent wake date) or reset,
//     vetoes only +1 up to 2.
//
// Note: get()/exists() see the database BEFORE the request; getAfter()/
// existsAfter() see it AFTER the whole batch/transaction.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function tribePath(tribeId) { return /databases/$(database)/documents/tribes/$(tribeId); }
    function memberPath(tribeId, uid) { return /databases/$(database)/documents/tribes/$(tribeId)/members/$(uid); }
    function proposalPath(tribeId, pid) { return /databases/$(database)/documents/tribes/$(tribeId)/proposals/$(pid); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }

    function isMember(tribeId) { return signedIn() && exists(memberPath(tribeId, request.auth.uid)); }
    function isAdmin(tribeId) {
      return isMember(tribeId) && get(memberPath(tribeId, request.auth.uid)).data.get('role', '') == 'admin';
    }

    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isTime(t) { return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    function proposalExpiry(p) { return p.createdAt + duration.value(2, 'h'); }

    // "yyyy-MM-dd" within ±2 days of server time (covers every timezone).
    function isRecentDate(s) {
      let p = s.split('-');
      let d = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return p.size() == 3
        && d > request.time - duration.value(2, 'd')
        && d < request.time + duration.value(2, 'd');
    }

    // ── Users & per-user alarm settings: owner only ──────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /user_alarms/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── Invite codes ──────────────────────────────────────────────────────────
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow update: if false;
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['tribeId', 'createdAt'])
        && getAfter(tribePath(request.resource.data.tribeId)).data.inviteCode == code
        && (
          // Admin (re)issuing a code for an existing tribe
          isAdmin(request.resource.data.tribeId)
          // or the creator issuing the first code for a tribe created in this batch
          || (!exists(tribePath(request.resource.data.tribeId))
              && getAfter(tribePath(request.resource.data.tribeId)).data.createdBy == request.auth.uid)
        );
      allow delete: if signedIn()
        && (isAdmin(resource.data.tribeId) || !exists(tribePath(resource.data.tribeId)));
    }

    // ── Tribes ────────────────────────────────────────────────────────────────
    match /tribes/{tribeId} {

      // Reading a tribe needs its (unguessable) ID; listing/searching is closed.
      allow get: if signedIn();
      allow list: if false;

      // Created together with the creator's admin member doc and its invite doc.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.get('activeProposalId', null) == null
        && isTime(request.resource.data.alarmTime)
        && request.resource.data.inviteCode is string
        && existsAfter(invitePath(request.resource.data.inviteCode))
        && getAfter(memberPath(tribeId, request.auth.uid)).data.role == 'admin';

      function memberJoins() {
        return changedKeys().hasOnly(['memberCount'])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && !exists(memberPath(tribeId, request.auth.uid))
          && existsAfter(memberPath(tribeId, request.auth.uid));
      }

      function memberLeavesOrIsRemoved() {
        return changedKeys().hasOnly(['memberCount'])
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && (!existsAfter(memberPath(tribeId, request.auth.uid)) || isAdmin(tribeId));
      }

      function adminEditsDetails() {
        return isAdmin(tribeId)
          && changedKeys().hasOnly(['name', 'description', 'photoUrl', 'inviteCode'])
          && (!('inviteCode' in changedKeys())
              || existsAfter(invitePath(request.resource.data.inviteCode)));
      }

      function activeId() { return resource.data.get('activeProposalId', null); }

      function opensProposal() {
        let newId = request.resource.data.get('activeProposalId', null);
        return changedKeys().hasOnly(['activeProposalId'])
          && newId != null
          && (activeId() == null
              || !exists(proposalPath(tribeId, activeId()))
              || get(proposalPath(tribeId, activeId())).data.status != 'pending')
          && getAfter(proposalPath(tribeId, newId)).data.proposedBy == request.auth.uid
          && getAfter(proposalPath(tribeId, newId)).data.status == 'pending';
      }

      // Vetoed (or otherwise resolved) proposal stops being active.
      function closesProposal() {
        return changedKeys().hasOnly(['activeProposalId'])
          && request.resource.data.get('activeProposalId', null) == null
          && activeId() != null
          && (!existsAfter(proposalPath(tribeId, activeId()))
              || getAfter(proposalPath(tribeId, activeId())).data.status != 'pending');
      }

      function acceptsProposal() {
        return changedKeys().hasOnly(['alarmTime', 'activeProposalId'])
          && activeId() != null
          && request.resource.data.get('activeProposalId', null) == null
          && get(proposalPath(tribeId, activeId())).data.status == 'pending'
          && getAfter(proposalPath(tribeId, activeId())).data.status == 'accepted'
          && request.resource.data.alarmTime == get(proposalPath(tribeId, activeId())).data.proposedTime;
      }

      function soloAdminSetsTime() {
        return isAdmin(tribeId)
          && resource.data.memberCount == 1
          && activeId() == null
          && changedKeys().hasOnly(['alarmTime'])
          && isTime(request.resource.data.alarmTime);
      }

      allow update: if signedIn() && (
        memberJoins()
        || (isMember(tribeId) && (
             memberLeavesOrIsRemoved()
             || adminEditsDetails()
             || opensProposal()
             || closesProposal()
             || acceptsProposal()
             || soloAdminSetsTime()
           ))
      );

      // The last member (whatever their role) can delete the tribe.
      allow delete: if isMember(tribeId) && resource.data.memberCount <= 1;

      // ── Members ─────────────────────────────────────────────────────────────
      match /members/{memberUid} {
        allow read: if isMember(tribeId);

        function freshMemberShape() {
          let d = request.resource.data;
          return d.keys().hasOnly(['displayName', 'photoUrl', 'role', 'todayStatus', 'todayWakeTime',
                                   'streakDays', 'bestStreak', 'totalWakes', 'vetoesUsed', 'rank',
                                   'joinedAt', 'joinedWith'])
            && d.streakDays == 0 && d.bestStreak == 0 && d.totalWakes == 0
            && d.vetoesUsed == 0 && d.todayStatus == 'sleeping';
        }

        allow create: if isOwner(memberUid)
          && !exists(memberPath(tribeId, memberUid))
          && freshMemberShape()
          && (
            // Creator: admin of a tribe created in this same batch
            (request.resource.data.role == 'admin'
              && !exists(tribePath(tribeId))
              && getAfter(tribePath(tribeId)).data.createdBy == request.auth.uid)
            // Joiner: plain member, holding this tribe's invite code, count +1
            || (request.resource.data.role == 'member'
              && get(invitePath(request.resource.data.joinedWith)).data.tribeId == tribeId
              && getAfter(tribePath(tribeId)).data.memberCount == get(tribePath(tribeId)).data.memberCount + 1)
          );

        function ownUpdateOk() {
          let d = request.resource.data;
          let o = resource.data;
          let ck = changedKeys();
          let oldStreak = o.get('streakDays', 0);
          let newStreak = d.get('streakDays', 0);
          let oldBest = o.get('bestStreak', 0);
          let oldWakes = o.get('totalWakes', 0);
          let oldVetoes = o.get('vetoesUsed', 0);
          let newWakeDate = 'lastWakeDate' in ck;
          return ck.hasOnly(['displayName', 'photoUrl', 'todayStatus', 'todayWakeTime', 'streakDays',
                             'bestStreak', 'totalWakes', 'lastWakeDate', 'rank', 'vetoesUsed'])
            && d.get('todayStatus', 'sleeping') in ['awake', 'sleeping', 'missed']
            // Streak: unchanged, reset (0/1), or +1 only alongside a new wake date
            && (newStreak == oldStreak || newStreak == 0 || newStreak == 1
                || (newStreak == oldStreak + 1 && newWakeDate))
            && (!('bestStreak' in ck)
                || d.bestStreak == (newStreak > oldBest ? newStreak : oldBest))
            && (!('totalWakes' in ck) || (d.totalWakes == oldWakes + 1 && newWakeDate))
            && (!newWakeDate
                || (isRecentDate(d.lastWakeDate) && d.lastWakeDate > o.get('lastWakeDate', '')))
            && (!('vetoesUsed' in ck) || (d.vetoesUsed == oldVetoes + 1 && d.vetoesUsed <= 2))
            && (!('rank' in ck) || (d.rank is int && d.rank >= 1));
        }

        allow update: if (isOwner(memberUid) && ownUpdateOk())
          // Admins can promote/demote others (admin transfer & succession)
          || (isAdmin(tribeId)
              && !isOwner(memberUid)
              && changedKeys().hasOnly(['role'])
              && request.resource.data.role in ['admin', 'member']);

        // Leaving (self) or being removed (admin); the tribe's count must drop by
        // one in the same batch, unless the tribe itself is being deleted.
        allow delete: if (isOwner(memberUid) || isAdmin(tribeId))
          && (!existsAfter(tribePath(tribeId))
              || getAfter(tribePath(tribeId)).data.memberCount == get(tribePath(tribeId)).data.memberCount - 1);
      }

      // ── Proposals ───────────────────────────────────────────────────────────
      match /proposals/{pid} {
        allow read: if isMember(tribeId);

        allow create: if isMember(tribeId)
          && request.resource.data.keys().hasOnly(['proposedBy', 'proposedByName', 'proposedTime',
                                                   'status', 'vetoedBy', 'vetoCount', 'createdAt'])
          && request.resource.data.proposedBy == request.auth.uid
          && request.resource.data.status == 'pending'
          && isTime(request.resource.data.proposedTime)
          && request.resource.data.proposedTime != get(tribePath(tribeId)).data.alarmTime
          && request.resource.data.vetoedBy.size() == 0
          && request.resource.data.vetoCount == 0
          && request.resource.data.createdAt == request.time
          && getAfter(tribePath(tribeId)).data.get('activeProposalId', null) == pid;

        function myVetoesBefore() {
          return get(memberPath(tribeId, request.auth.uid)).data.get('vetoesUsed', 0);
        }

        // One veto kills a proposal, within the 2h window, never your own,
        // costing one of your 2 vetoes, and clearing the tribe's active slot.
        function vetoes() {
          return request.time < proposalExpiry(resource.data)
            && resource.data.proposedBy != request.auth.uid
            && changedKeys().hasOnly(['status', 'vetoedBy', 'vetoCount'])
            && request.resource.data.status == 'vetoed'
            && request.resource.data.vetoedBy == [request.auth.uid]
            && request.resource.data.vetoCount == 1
            && myVetoesBefore() < 2
            && getAfter(memberPath(tribeId, request.auth.uid)).data.get('vetoesUsed', 0) == myVetoesBefore() + 1
            && getAfter(tribePath(tribeId)).data.get('activeProposalId', null) == null;
        }

        // Anyone in the tribe can finalize the active proposal once its window has
        // passed; the tribe's alarm must change to the proposed time in the same write.
        function accepts() {
          return request.time >= proposalExpiry(resource.data)
            && changedKeys().hasOnly(['status'])
            && request.resource.data.status == 'accepted'
            && get(tribePath(tribeId)).data.get('activeProposalId', null) == pid
            && getAfter(tribePath(tribeId)).data.alarmTime == resource.data.proposedTime;
        }

        allow update: if isMember(tribeId)
          && resource.data.status == 'pending'
          && (vetoes() || accepts());

        // Cleanup when an admin deletes the tribe.
        allow delete: if isAdmin(tribeId);
      }
    }
  }
}
