rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== USER PROFILES =====
    // Each user reads/writes only their own document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ===== USER ALARMS =====
    // Each user reads/writes only their own alarm document.
    match /user_alarms/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ===== TRIBES =====
    // Any authenticated user can read tribe data (needed for joining by invite code).
    // Creation is allowed by any authenticated user.
    // Updates restricted to tribe members.
    match /tribes/{tribeId} {

      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && exists(
        /databases/$(database)/documents/tribes/$(tribeId)/members/$(request.auth.uid)
      );
      allow delete: if false;

      // ===== TRIBE MEMBERS =====
      // Any tribe member can read the member list.
      // Each user writes only their own member document.
      match /members/{memberUid} {
        allow read: if request.auth != null && exists(
          /databases/$(database)/documents/tribes/$(tribeId)/members/$(request.auth.uid)
        );
        allow create: if request.auth != null && request.auth.uid == memberUid;
        allow update: if request.auth != null && request.auth.uid == memberUid;
        allow delete: if false;
      }

      // ===== PROPOSALS =====
      // Any tribe member can read, create, or update proposals.
      // Update covers: proposer cancelling, other members casting veto.
      // Deletion is not allowed (expired proposals remain for audit).
      match /proposals/{proposalId} {
        allow read: if request.auth != null && exists(
          /databases/$(database)/documents/tribes/$(tribeId)/members/$(request.auth.uid)
        );
        allow create: if request.auth != null && exists(
          /databases/$(database)/documents/tribes/$(tribeId)/members/$(request.auth.uid)
        );
        allow update: if request.auth != null && exists(
          /databases/$(database)/documents/tribes/$(tribeId)/members/$(request.auth.uid)
        );
        allow delete: if false;
      }
    }
  }
}
